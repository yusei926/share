# PCsensor FootSwitch (3553:b001): never expose the factory keyboard/mouse
# shortcuts to the desktop.  The AVP teleop process reads the keyboard event
# directly and takes an EVIOCGRAB only while a teleop session is active.
#
# ``uaccess`` is preferred when logind grants an ACL, but this desktop's local
# tty session does not receive one.  ``plugdev`` is therefore the deterministic
# fallback; it applies only to this exact USB vendor/product pair, not to all
# /dev/input devices.
SUBSYSTEM=="input", ATTRS{idVendor}=="3553", ATTRS{idProduct}=="b001", ENV{LIBINPUT_IGNORE_DEVICE}="1", GROUP="plugdev", MODE="0660", TAG+="uaccess"
