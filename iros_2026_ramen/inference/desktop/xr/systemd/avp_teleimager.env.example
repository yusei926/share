# Copy to /etc/default/iros-ramen-avp-teleimager on each Orin after visually
# confirming which D405 is physically mounted on each wrist.  Never infer
# these roles from /dev/videoN enumeration order.
WRIST_LEFT_SERIAL=
WRIST_RIGHT_SERIAL=

# Optional when more than one non-RealSense UVC camera is connected.
# HEAD_CAMERA_SERIAL=
